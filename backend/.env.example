# Copy this to .env and fill in values before running locally or deploying.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True

# Allowed hosts (comma-separated). Add your Render domain in production.
# Example production value: your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# CORS (production only — ignored when DEBUG=True)
# Example: https://your-admin-portal.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional: regex origins (comma-separated) — e.g. Vercel preview deploys.
# Example: ^https://.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# Database
# ---------------------------------------------------------------------------
# Production: set a single DATABASE_URL (e.g. Neon). Append ?sslmode=require.
# The PostGIS extension must be enabled on the database:
#   CREATE EXTENSION IF NOT EXISTS postgis;
# When DATABASE_URL is set it takes precedence over the DB_* vars below.
# Example: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Local dev fallback (matches docker-compose defaults) — used only when
# DATABASE_URL is empty.
DB_NAME=fps_db
DB_USER=fps_user
DB_PASSWORD=kushagra123
DB_HOST=localhost
DB_PORT=5432

# Media / photo storage
# ---------------------------------------------------------------------------
# Production: photos MUST go to durable storage — Render's disk is ephemeral.
# When CLOUDINARY_URL is set, all uploaded photos are stored in Cloudinary.
# When empty (local dev), uploads fall back to the local filesystem (./media).
# Get this value from the Cloudinary dashboard (Account Details → API Environment variable).
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
